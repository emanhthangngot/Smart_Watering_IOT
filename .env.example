# Copy to .env and fill with real values. Never commit .env.
#
# Append-only convention (plans/reports/plan.md §2, merge-safety):
# add new keys inside your own owner block, never reorder existing blocks.

# --- dev: shared config (config.py) ---
TEAM_CODE=VAMOS
FARM_ENVIRONMENT=FARM
ACTUATION_TARGET=none
# Comma-separated browser origins allowed to call FastAPI. Do not use `*`
# when exposing operator write endpoints.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- M1 feat/data-plane: MQTT + Supabase ---
# MQTT telemetry viewer — local-only credentials. Do not commit this file.
MQTT_HOST=mqtt-hackathon.lexatek.vn
MQTT_PORT=443
MQTT_USERNAME=YOUR_USERNAME
MQTT_PASSWORD=YOUR_PASSWORD
MQTT_CLIENT_ID=YOUR_TEST_KEY_OR_CLIENT_ID
MQTT_TOPIC=hackathon/your-team-code/test/telemetry
MQTT_TIMEOUT_MS=30000
MQTT_MAX_MESSAGES=1
# Bounded snapshots waiting for PostgreSQL. Overload drops the oldest item
# and exposes the drop count on /health.
MQTT_QUEUE_MAX=128

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres DSN via the transaction pooler (port 6543, no prepared statements —
# store/db.py sets statement_cache_size=0 for this). Preferred path.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session-mode fallback (port 5432) if the pooler is blocked at the venue
# network (plan.md §18 open question 8). Optional.
SUPABASE_DB_URL_DIRECT=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local Docker PostgreSQL (`docker compose -f store/docker-compose.yml up -d --wait`).
# store/db.py now falls back to this automatically when SUPABASE_DB_URL and
# SUPABASE_DB_URL_DIRECT are both unset or unreachable — no need to paste the
# DSN into SUPABASE_DB_URL_DIRECT. Only set LOCAL_POSTGRES_DSN if you changed
# the compose file's user/password/port away from the defaults below.
# LOCAL_POSTGRES_DSN=postgresql://farmops:farmops_dev@127.0.0.1:54322/farmops

# --- M4 feat/tools-runner-api: auth ---
OPERATOR_TOKEN=
OPERATOR_ACTOR=operator

# --- dev + M3 feat/agents: LLM provider (coordination gate C5) ---
# Empty LLM_PROVIDER/LLM_API_KEY disables the narration boundary; agents/
# planner.py always falls back to a deterministic result, so this is safe
# to leave unset. Never commit a real key. One provider only — no runtime
# provider switching, no multi-provider routing (plan.md Scope Boundary).
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4-flash-0731
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_OUTPUT_TOKENS=512
# Comma-separated hostnames the narration call is allowed to reach.
LLM_EGRESS_ALLOWLIST=openrouter.ai
